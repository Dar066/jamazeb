# Copy this file to .env.local for local development, and add the same
# variables in Vercel > Project > Settings > Environment Variables.

# Full public address of the store, no trailing slash. Used for SEO links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store WhatsApp number, international format, digits only (e.g. 923001234567).
# Leave empty and the chat shows a demo note instead of opening WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Secret used to sign demo payment links and results (server only, never NEXT_PUBLIC).
# Any long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOCK_PAYMENT_SECRET=

# Customer care hours shown on the Help > Contact page, e.g. Mon–Sat, 10am–7pm.
NEXT_PUBLIC_SUPPORT_HOURS=

# Admin dashboard (/admin). Leave ADMIN_PASSWORD empty for the public demo:
# the login page then shows the demo password so visitors can look around.
# For a real store, set a strong password and a long random session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Database (Supabase PostgreSQL). Server only: never prefix with NEXT_PUBLIC.
# Leave empty for demo mode (orders kept in each visitor's browser).
# Use the Transaction pooler address (port 6543) with the jamazeb_app login from
# db/jamazeb-app-user.sql, e.g.
# postgresql://jamazeb_app.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
